{
  "name": "character-picker",
  "version": "0.1.0",
  "description": "Random character on cloudflare worker",
  "license": "Apache-2.0",
  "author": "Sn0wo2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sn0wo2/character-picker.git"
  },
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=24"
  },
  "imports": {
    "#src/*": "./src/*.ts"
  },
  "files": [
    "build",
    "public",
    "LICENSE"
  ],
  "scripts": {
    "update-geometry": "node scripts/update-geometry.js",
    "update-version": "node scripts/update-version.js",
    "dev": "bun run update-geometry && vite",
    "start": "node build/index.js",
    "build": "bun run update-geometry && bun scripts/build.mjs",
    "build:worker": "bun run update-geometry && vite build",
    "preview": "bun run build:worker && vite preview",
    "deploy": "bun run update-version && bun run build:worker && wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write --error-on-warnings .",
    "check": "tsc --noEmit",
    "test": "node --test",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; for (const path of ['build', 'dist']) rmSync(path, { recursive: true, force: true });\"",
    "security": "bun audit --registry=https://registry.npmjs.org",
    "ci": "bun run lint && bun run check && bun run test && bun run build && bun run build:worker && bun run security",
    "release": "goreleaser release --clean",
    "release:dry": "goreleaser release --clean --snapshot"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "hono": "^4.11.4",
    "image-size": "^2.0.2",
    "uint8array-extras": "^1.5.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.21.0",
    "@biomejs/biome": "^2.6.6",
    "@types/node": "^24",
    "pngjs": "7.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.0.0",
    "wrangler": "^4.59.2"
  }
}
